{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"types": [
			"node",
			"qunit"
		],
		"exactOptionalPropertyTypes": false,
		"paths": {
			"@oidfed/core": [
				"../../packages/core/src/index.ts"
			],
			"@oidfed/authority": [
				"../../packages/authority/src/index.ts"
			],
			"@oidfed/leaf": [
				"../../packages/leaf/src/index.ts"
			],
			"@oidfed/oidc": [
				"../../packages/oidc/src/index.ts"
			],
			"@oidfed/wallet": [
				"../../packages/wallet/src/index.ts"
			],
			"@oidfed/crypto": [
				"../../packages/crypto/src/index.ts"
			],
			"@oidfed/crypto/web": [
				"../../packages/crypto/src/web.ts"
			],
			"@oidfed/crypto/jose": [
				"../../packages/crypto/src/jose.ts"
			]
		},
		"rootDir": "../..",
		"noEmit": true
	},
	"include": [
		"./**/*.ts"
	],
	"exclude": [
		".build"
	]
}
