{
	"name": "@oidfed/monorepo",
	"version": "2.0.0",
	"description": "The complete OpenID Federation 1.0 implementation for JavaScript — runtime-agnostic, spec-compliant, built on Web API standards.",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"scripts": {
		"build": "turbo run build --filter='./packages/*' --filter='./tools/*'",
		"build:apps": "turbo run build --filter='./apps/*' --filter='./apps/shared/*'",
		"test": "pnpm test:tap && pnpm --filter './tools/*' test",
		"test:apps": "pnpm --filter './apps/*' --filter './apps/shared/*' --if-present test",
		"quick:test": "tsx --tsconfig tests/tap/tsconfig.json tests/tap/run-node.ts && pnpm --filter './tools/*' test",
		"test:watch": "vitest",
		"test:tap": "pnpm test:tap:bun && pnpm test:tap:deno && pnpm test:tap:workerd && pnpm test:tap:electron && pnpm test:tap:browser && tsx --tsconfig tests/tap/tsconfig.json tests/tap/run-node.ts",
		"test:tap:bun": "bash tests/tap/.bun.sh",
		"test:tap:deno": "bash tests/tap/.deno.sh",
		"test:tap:workerd": "bash tests/tap/.workerd.sh",
		"test:tap:electron": "bash tests/tap/.electron.sh",
		"test:tap:browser": "bash tests/tap/.browsers.sh",
		"test:coverage": "bash scripts/coverage-check.sh",
		"typecheck": "turbo run typecheck --filter='./packages/*' --filter='./tools/*' && tsc -p tests/tap/tsconfig.json --noEmit && pnpm typecheck:e2e && pnpm typecheck:scripts && pnpm typecheck:conformance",
		"typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
		"typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
		"typecheck:conformance": "tsc -p tests/conformance/tsconfig.json --noEmit",
		"test:conformance": "tsx --tsconfig tests/conformance/tsconfig.json tests/conformance/run.ts --profile deployed",
		"test:conformance:full": "tsx --tsconfig tests/conformance/tsconfig.json tests/conformance/run.ts --profile full",
		"test:conformance:unit": "vitest run --config tests/conformance/vitest.config.ts --configLoader native --project unit",
		"typecheck:apps": "turbo run typecheck --filter='./apps/*' --filter='./apps/shared/*'",
		"lint": "biome check --error-on-warnings biome.json packages apps tools tests scripts",
		"lint:fix": "biome check --write biome.json packages apps tools tests scripts",
		"clean": "turbo run clean",
		"setup:e2e": "bash scripts/setup-e2e.sh",
		"test:e2e": "NODE_EXTRA_CA_CERTS=$(cat .certs/ca-path.txt)/rootCA.pem vitest run --config tests/e2e/vitest.config.ts",
		"dev:federation": "NODE_EXTRA_CA_CERTS=$(cat .certs/ca-path.txt)/rootCA.pem tsx --tsconfig scripts/tsconfig.json scripts/dev-federation.ts",
		"cli": "NODE_TLS_REJECT_UNAUTHORIZED=0 node --no-warnings tools/cli/dist/bin.js",
		"oidfed": "pnpm -s cli",
		"build:publish": "turbo run build --filter='@oidfed/core' --filter='@oidfed/authority' --filter='@oidfed/leaf' --filter='@oidfed/oidc' --filter='@oidfed/wallet' --filter='@oidfed/cli'",
		"release": "node scripts/release.mjs",
		"test:scripts": "node --test scripts/*.test.mjs",
		"prepare": "husky",
		"commit": "commit",
		"commitlint": "commitlint --edit",
		"release:verify": "pnpm build:publish && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm --filter './tools/*' test && node scripts/check-single-core.mjs && pnpm test:scripts && node scripts/check-pack-manifests.mjs",
		"security:install": "node scripts/security/install.mjs",
		"security:test": "node --test scripts/security/*.test.mjs",
		"security:lint": "node scripts/security/run.mjs lint",
		"security:architecture": "node scripts/security/run.mjs architecture",
		"security:advisory": "node scripts/security/run.mjs advisory",
		"security:secrets": "node scripts/security/run.mjs secrets",
		"security:dependencies": "node scripts/security/run.mjs dependencies",
		"security:artifacts": "node scripts/security/run.mjs artifacts",
		"security:fuzz": "node scripts/security/run.mjs fuzz",
		"security:mutation": "node scripts/security/run.mjs mutation",
		"security:workflows": "node scripts/security/run.mjs workflows",
		"security:check": "pnpm security:test && pnpm security:lint && pnpm security:architecture && pnpm security:secrets && pnpm security:dependencies && pnpm security:artifacts && pnpm security:workflows"
	},
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Dahkenangnon/oidfed.git"
	},
	"author": {
		"name": "Justin Dah-kenangnon",
		"email": "dah.kenangnon@gmail.com"
	},
	"homepage": "https://oidfed.com",
	"bugs": {
		"url": "https://github.com/Dahkenangnon/oidfed/issues"
	},
	"keywords": [
		"openid",
		"federation",
		"oidc",
		"oauth2",
		"trust-chain",
		"entity-configuration",
		"trust-mark"
	],
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0",
		"pnpm": ">=10"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "0.18.5",
		"@biomejs/biome": "^2.6.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@commitlint/prompt-cli": "^21.2.4",
		"@jazzer.js/core": "4.0.0",
		"@oidfed/authority": "workspace:*",
		"@oidfed/core": "workspace:*",
		"@oidfed/leaf": "workspace:*",
		"@oidfed/oidc": "workspace:*",
		"@oidfed/wallet": "workspace:*",
		"@playwright/test": "^1.64.0",
		"@stryker-mutator/core": "10.1.1",
		"@types/express": "^5.0.6",
		"@types/node": "^22.20.5",
		"@types/oidc-provider": "^9.12.1",
		"@types/qunit": "^2.19.14",
		"@types/yauzl": "3.4.0",
		"c8": "^12.0.0",
		"dependency-cruiser": "18.7.2",
		"electron": "^45.0.0",
		"esbuild": "^0.28.2",
		"eslint": "10.15.0",
		"eslint-plugin-jsdoc": "65.4.8",
		"eslint-plugin-regexp": "3.3.3",
		"express": "^5.3.0",
		"express-rate-limit": "8.7.1",
		"fast-check": "4.10.2",
		"husky": "^9.1.7",
		"jose": "^6.2.13",
		"jscpd": "5.4.3",
		"knip": "6.45.1",
		"oidc-provider": "^9.13.0",
		"openid-client": "6.8.8",
		"publint": "0.3.25",
		"qunit": "^3.0.0",
		"semver": "7.8.6",
		"ts-blank-space": "^0.9.0",
		"tsd": "0.33.0",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"turbo": "^2.11.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "8.72.2",
		"undici": "^8.12.2",
		"vitest": "^5.0.5",
		"yaml": "2.9.1",
		"yauzl": "3.4.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"electron",
			"esbuild"
		],
		"overrides": {
			"body-parser@>=2.0.0 <2.4.0": "^2.4.0",
			"brace-expansion@>=5.0.0 <5.0.10": "^5.0.10",
			"esbuild": "^0.28.1",
			"fast-uri@>=3.0.0 <3.1.9": "^3.1.9",
			"js-yaml@<4.3.1": "^4.3.1",
			"postcss@<8.5.18": "^8.5.18",
			"qs@<6.16.1": "^6.16.1",
			"source-map-js@<1.2.2": "^1.2.2",
			"undici@>=7.0.0 <7.30.1": "^7.30.1",
			"valibot@<=1.4.1": "^1.4.2",
			"minimatch@>=7.0.0 <11.0.1": "11.0.8"
		}
	}
}
