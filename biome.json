{
	"$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
	"formatter": {
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": { "preset": "recommended" }
	},
	"overrides": [
		{
			"includes": ["tests/tap/**/*.ts"],
			"linter": {
				"rules": {
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/**"],
			"formatter": { "enabled": false },
			"linter": { "enabled": false },
			"assist": {
				"actions": {
					"source": {
						"organizeImports": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/shared/**"],
			"formatter": { "enabled": true },
			"linter": { "enabled": true },
			"assist": { "actions": { "source": { "organizeImports": "on" } } }
		}
	],
	"files": {
		"includes": [
			"packages/**/src/**/*.ts",
			"packages/**/src/**/*.tsx",
			"packages/**/src/**/*.jsx",
			"packages/**/test/**/*.ts",
			"packages/**/test/**/*.tsx",
			"apps/**/src/**/*.ts",
			"apps/**/src/**/*.tsx",
			"apps/**/app/**/*.ts",
			"apps/**/app/**/*.tsx",
			"tools/**/src/**/*.ts",
			"tools/**/src/**/*.tsx",
			"tools/**/test/**/*.ts",
			"tools/**/test/**/*.tsx",
			"tests/**/*.ts",
			"examples/adapters/**/*.ts",
			"scripts/**/*.sh",
			"scripts/**/*.ts",
			"!apps/**/.react-router"
		],
		"ignoreUnknown": true
	}
}
