{
	"name": "@oidfed/wallet",
	"version": "3.0.0",
	"description": "OpenID Federation for Wallet Architectures: composable provider, issuer, and verifier roles and federation-backed trust operations.",
	"license": "Apache-2.0",
	"author": "Justin Dah-kenangnon <dah.kenangnon@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/Dahkenangnon/oidfed.git",
		"directory": "packages/wallet"
	},
	"homepage": "https://oidfed.com/docs/api/wallet",
	"bugs": {
		"url": "https://github.com/Dahkenangnon/oidfed/issues"
	},
	"keywords": [
		"openid-federation",
		"wallet",
		"openid4vci",
		"openid4vp",
		"trust-chain",
		"wallet-attestation"
	],
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"NOTICE"
	],
	"sideEffects": false,
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@oidfed/core": "workspace:^",
		"@oidfed/crypto": "workspace:^",
		"zod": "^4.6.7"
	}
}
